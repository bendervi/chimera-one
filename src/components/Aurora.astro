---
// Abstract background art: color fields with glass panes in the Panorama palette, no glows
// (the owner chose abstract imagery over posters and album art). Pure CSS, no
// image requests. Decorative only.
interface Props {
    variant: "hero" | "night" | "amber" | "sea" | "violet";
}

const { variant } = Astro.props;
---

<div class:list={["aurora", `aurora-${variant}`]} aria-hidden="true">
    <span class="pane pane-a"></span>
    <span class="pane pane-b"></span>
</div>
