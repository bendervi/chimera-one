---
// The product page. Section order follows the App Store creative: value and
// expectation first, then the strongest reasons, objections, and the ask again.
// Each visual shows the device the visitor is likely holding (.on-desktop /
// .on-tablet / .on-phone); hidden lazy images are never downloaded.
//
// Visual language: Apple-neutral surfaces and type; the Panorama blue appears
// only in the hero and the closing download band. No decorative shapes, no
// per-section colors, no icon tiles — the app's own screens carry the page.
import type { Locale } from "../i18n";
import { href, english } from "../i18n";
import Device from "./Device.astro";
import Badges from "./Badges.astro";
import { Image } from "astro:assets";
import logoURL from "../assets/logo.svg";
import appIcon from "../assets/app-icon.png";

import homeLight from "../assets/captures/home-light.png";
import macGuide from "../assets/captures/mac-guide.png";
import macBook from "../assets/captures/mac-book.png";
import liveDark from "../assets/captures/livetv-dark.png";
import ipadLive from "../assets/captures/ipad-livetv.png";
import ipadGallery from "../assets/captures/ipad-gallery.png";
import tvLive from "../assets/captures/tv-livetv.png";
import tvGuide from "../assets/captures/tv-guide.png";
import detail from "../assets/captures/detail.png";
import player from "../assets/captures/player-landscape.png";
import sourceTypes from "../assets/captures/sourcetypes.png";
import detailDark from "../assets/captures/detail-dark.png";
import musicAlbum from "../assets/captures/music-album.png";
import photoViewer from "../assets/captures/gallery-photo.png";
import reader from "../assets/captures/book-reader-chrome.png";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = locale.strings;
const lines = (s: string) => s.split("\n");
const hostCards = [
    { key: "video", layout: "wide", text: t.selfhost.video, shot: detailDark, alt: t.alt.detailDark },
    { key: "music", layout: "half", text: t.selfhost.music, shot: musicAlbum, alt: t.alt.musicAlbum },
    { key: "photos", layout: "half", text: t.selfhost.photos, shot: photoViewer, alt: t.alt.photoViewer },
    { key: "books", layout: "wide wide-reverse", text: t.selfhost.books, shot: reader, alt: t.alt.reader },
] as const;
---

<!-- Hero -->
<section class="hero" aria-labelledby="hero-title">
    <img class="hero-mark" src={logoURL.src} alt="" aria-hidden="true" />
    <div class="wrap-wide hero-grid">
        <div class="hero-copy">
            <p class="hero-eyebrow reveal-up">{t.hero.eyebrow}</p>
            <h1 id="hero-title" class="hero-title reveal-up">
                {lines(t.hero.title).map((line) => <span>{line}</span>)}
            </h1>
            <p class="hero-subtitle reveal-up">{t.hero.subtitle}</p>
            <div class="reveal-up"><Badges locale={locale} campaign="web-hero" /></div>
            <p class="hero-note reveal-up">{t.hero.note}</p>
        </div>
        <div class="hero-visual">
            <div class="hero-stage">
                <Device
                    class="hero-mac not-phone"
                    kind="mac"
                    src={macGuide}
                    alt={t.alt.macGuide}
                    sizes="(max-width: 734px) 1px, (max-width: 1068px) 80vw, 720px"
                    eager
                />
                <Device
                    class="hero-phone"
                    kind="phone"
                    src={homeLight}
                    alt={t.alt.homeIPhone}
                    sizes="(max-width: 734px) 62vw, (max-width: 1068px) 26vw, 250px"
                    eager
                />
            </div>
        </div>
    </div>
</section>

<!-- Every Apple screen -->
<section class="section devices" id="features" aria-labelledby="devices-title">
    <div class="wrap center reveal">
        <h2 id="devices-title" class="section-title">{t.devices.title}</h2>
        <p class="section-body">{t.devices.body}</p>
    </div>
    <div class="device-row snap-row" role="list">
        <div class="device-cell cell-tv" role="listitem">
            <Device kind="tv" src={tvLive} alt={t.alt.tvLive} sizes="(max-width: 734px) 80vw, 520px" />
            <p class="device-label">{t.devices.tv}</p>
        </div>
        <div class="device-cell cell-mac" role="listitem">
            <Device kind="mac" src={macBook} alt={t.alt.macBook} sizes="(max-width: 734px) 80vw, 480px" />
            <p class="device-label">{t.devices.mac}</p>
        </div>
        <div class="device-cell cell-ipad" role="listitem">
            <Device kind="ipad" src={ipadGallery} alt={t.alt.photos} sizes="(max-width: 734px) 60vw, 240px" />
            <p class="device-label">{t.devices.ipad}</p>
        </div>
        <div class="device-cell cell-phone" role="listitem">
            <Device kind="phone" src={liveDark} alt={t.alt.liveIPhone} sizes="(max-width: 734px) 46vw, 150px" />
            <p class="device-label">{t.devices.iphone}</p>
        </div>
    </div>
</section>

<!-- Self-hosting: video servers, music, photos, books -->
<section class="section section-alt selfhost" id="self-hosting" aria-labelledby="selfhost-title">
    <div class="wrap-wide split-head reveal">
        <div>
            <p class="eyebrow">{t.selfhost.eyebrow}</p>
            <h2 id="selfhost-title" class="section-title">{t.selfhost.title}</h2>
        </div>
        <div>
            <p class="section-body">{t.selfhost.body}</p>
            <p class="server-line" aria-label={t.selfhost.eyebrow}>
                {t.selfhost.servers.map((name) => <span>{name}</span>)}
            </p>
        </div>
    </div>
    <div class="wrap-wide host-grid">
        {
            hostCards.map((card) => (
                <article class:list={["host-card", `host-${card.key}`, card.layout, "reveal"]}>
                    <div class="host-copy">
                        <p class="host-servers">{card.text.servers}</p>
                        <h3>{card.text.title}</h3>
                        <p class="host-body">{card.text.body}</p>
                        <ul class="plain-list">{card.text.points.map((p) => <li>{p}</li>)}</ul>
                    </div>
                    <div class="host-visual">
                        <Device
                            kind="phone"
                            src={card.shot}
                            alt={card.alt}
                            sizes="(max-width: 734px) 60vw, (max-width: 1068px) 34vw, 260px"
                        />
                    </div>
                </article>
            ))
        }
    </div>
    <ul class="wrap-wide fact-row reveal">
        {
            t.selfhost.direct.map((d) => (
                <li>
                    <strong>{d.title}</strong>
                    <span>{d.body}</span>
                </li>
            ))
        }
    </ul>
</section>

<!-- Live TV -->
<section class="section band-dark" aria-labelledby="live-title">
    <div class="wrap feature-head reveal">
        <div>
            <p class="eyebrow">{t.live.eyebrow}</p>
            <h2 id="live-title" class="section-title">{t.live.title}</h2>
            <p class="section-body">{t.live.body}</p>
        </div>
        <ul class="plain-list">{t.live.points.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="feature-visual reveal">
        <Device class="on-desktop" kind="tv" src={tvGuide} alt={t.alt.tvLive} sizes="980px" />
        <Device class="on-tablet" kind="ipad" src={ipadLive} alt={t.alt.liveIPad} sizes="70vw" />
        <Device class="on-phone" kind="phone" src={liveDark} alt={t.alt.liveIPhone} sizes="70vw" />
    </div>
</section>

<!-- Movies & Series -->
<section class="section" aria-labelledby="library-title">
    <div class="wrap feature-split">
        <div class="feature-copy reveal">
            <p class="eyebrow">{t.library.eyebrow}</p>
            <h2 id="library-title" class="section-title">{t.library.title}</h2>
            <p class="section-body">{t.library.body}</p>
            <ul class="plain-list">{t.library.points.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="feature-pair reveal">
            <Device kind="phone" src={detail} alt={t.alt.detail} sizes="(max-width: 734px) 58vw, 260px" />
            <Device
                class="pair-back not-phone"
                kind="phone"
                src={homeLight}
                alt={t.alt.homeIPhone}
                sizes="(max-width: 734px) 1px, 230px"
            />
        </div>
    </div>
</section>

<!-- Player -->
<section class="section band-dark" aria-labelledby="player-title">
    <div class="wrap feature-head reveal">
        <div>
            <p class="eyebrow">{t.player.eyebrow}</p>
            <h2 id="player-title" class="section-title">{t.player.title}</h2>
            <p class="section-body">{t.player.body}</p>
        </div>
        <ul class="plain-list">{t.player.points.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="feature-visual reveal">
        <Device kind="display" src={player} alt={t.alt.player} sizes="(max-width: 734px) 92vw, (max-width: 1068px) 88vw, 980px" />
    </div>
</section>

<!-- Sources -->
<section class="section" aria-labelledby="sources-title">
    <div class="wrap feature-split feature-split-reverse">
        <div class="feature-copy reveal">
            <h2 id="sources-title" class="section-title">{t.sources.title}</h2>
            <p class="section-body">{t.sources.body}</p>
            <ul class="source-list">{t.sources.list.map((s) => <li>{s}</li>)}</ul>
            <p class="fineprint">{t.sources.disclaimer}</p>
        </div>
        <div class="feature-single reveal">
            <Device kind="phone" src={sourceTypes} alt={t.alt.sources} sizes="(max-width: 734px) 58vw, 280px" />
        </div>
    </div>
</section>

<!-- Pro -->
<section class="section section-alt" id="pro" aria-labelledby="pro-title">
    <div class="wrap pro reveal">
        <div class="pro-copy">
            <Image class="pro-icon" src={appIcon} alt="" width={64} height={64} densities={[1, 2, 3]} />
            <p class="eyebrow">{t.pro.eyebrow}</p>
            <h2 id="pro-title" class="section-title">{t.pro.title}</h2>
            <p class="section-body">{t.pro.body}</p>
        </div>
        <dl class="pro-list">
            {
                t.pro.features.map((f) => (
                    <div>
                        <dt>{f.title}</dt>
                        <dd>{f.body}</dd>
                    </div>
                ))
            }
        </dl>
    </div>
</section>

<!-- Privacy -->
<section class="section section-tight" aria-labelledby="privacy-title">
    <div class="wrap">
        <h2 id="privacy-title" class="section-title reveal">{t.privacy.title}</h2>
        <ul class="fact-row fact-row-3 reveal">
            {
                t.privacy.points.map((p) => (
                    <li>
                        <strong>{p.title}</strong>
                        <span>{p.body}</span>
                    </li>
                ))
            }
        </ul>
        <p><a class="text-link" href={href(english, "privacy/")}>{t.privacy.link}</a></p>
    </div>
</section>

<!-- FAQ -->
<section class="section section-alt" aria-labelledby="faq-title">
    <div class="wrap faq">
        <div class="faq-side">
            <h2 id="faq-title" class="section-title">{t.faq.title}</h2>
            <p><a class="text-link" href={href(english, "support/")}>{t.faq.more}</a></p>
        </div>
        <div class="faq-list">
            {
                t.faq.items.map((item) => (
                    <details class="faq-item">
                        <summary>{item.q}</summary>
                        <p>{item.a}</p>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<!-- Final call to action -->
<section class="cta" aria-labelledby="cta-title">
    <div class="wrap center">
        <Image class="cta-icon" src={appIcon} alt="" width={76} height={76} densities={[1, 2, 3]} />
        <h2 id="cta-title" class="cta-title">{t.cta.title}</h2>
        <p class="cta-body">{t.cta.body}</p>
        <Badges locale={locale} campaign="web-footer" />
    </div>
</section>
