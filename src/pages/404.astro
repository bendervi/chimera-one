---
// Page not found (served by Cloudflare for any unknown path).
import Base from "../layouts/Base.astro";
import { english, href } from "../i18n";
---

<Base locale={english} title="Page not found — Chimera" description="This page doesn't exist." page="404/">
    <article class="doc">
        <h1>Page not found</h1>
        <p class="lead">This page doesn't exist or has moved.</p>
        <p><a class="text-link" href={href(english)}>Go to the Chimera home page</a></p>
        <p><a class="text-link" href={href(english, "support/")}>Get support</a></p>
    </article>
</Base>
