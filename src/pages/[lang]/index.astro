---
// Localized home pages (/de/, /ar/, …).
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { locales, type Locale } from "../../i18n";
import { homeJSONLD } from "../_home-data";

export function getStaticPaths() {
    return locales.filter((l) => l.path).map((locale) => ({ params: { lang: locale.path }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = locale.strings;
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} page="" localized jsonLD={homeJSONLD(locale)}>
    <Home locale={locale} />
</Base>
